# Optional: enables the real LLM function-calling agent on Gemini's OpenAI-compatible free tier.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
# auto (default), llm (fail closed if no key), or deterministic (offline demo/test mode)
AGENT_MODE=auto
