# Copy to .env and set LLM_API_KEY to enable the agent loop.
# A free Google AI Studio key works: https://aistudio.google.com/apikey
# Without a key the service still runs, using the deterministic fallback.

# --- LLM (any OpenAI-compatible endpoint) ------------------------------------
# These three must agree: the key, the endpoint it belongs to, and a model that
# endpoint serves. A key for one provider against another's URL fails every call
# and the service degrades to the deterministic fallback — it still answers, so
# the symptom is "replies got worse", not an outage. GET /health reports the
# model actually configured.
#
#   Google AI Studio (free)  https://generativelanguage.googleapis.com/v1beta/openai/  gemini-2.5-flash
#   OpenAI-compatible gateway  http://<host>:<port>/v1/                                <model it serves>
LLM_PROVIDER=openai_compatible
# GEMINI_API_KEY is accepted as a fallback when LLM_API_KEY is empty.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# --- Orchestration -----------------------------------------------------------
# auto          use the model; fall back to the deterministic path on an outage
# llm           use the model and fail closed; never silently degrade
# deterministic never call a provider (offline demo and test mode)
AGENT_MODE=auto

# Retries for transient provider errors (429/5xx/timeouts), with backoff.
# Non-transient errors (e.g. 400) are never retried.
LLM_TRANSIENT_RETRIES=2
LLM_RETRY_BACKOFF=0.6

# Hard ceiling on agent turns per request. The only loop cap; LangGraph's
# recursion limit is derived from it so the two cannot drift apart.
AGENT_MAX_STEPS=8

# How many times a guard may send a turn back for another grounded round.
AGENT_MAX_NUDGES=2

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATES=8

# --- Demo affordances --------------------------------------------------------
# orders.json is a frozen snapshot; on this date every scenario it was built to
# exercise holds at once. Clear it to use the real system date, as production
# would. See README, "A note on dates".
DEMO_AS_OF=2026-07-29
